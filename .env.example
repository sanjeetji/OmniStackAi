OMNISTACKAI_ENV=local
OMNISTACKAI_LOG_LEVEL=info
OMNISTACKAI_OLLAMA_BASE_URL=http://127.0.0.1:11434
OMNISTACKAI_OLLAMA_MODEL=qwen2.5-coder:14b
# PC-014: 1 keeps every model call of a build on this machine (plan, repairs, page design). The
# model above is checked against what Ollama has installed; `scripts/omnistack.sh status` shows the
# model recommended for this machine.
OMNISTACKAI_PREFER_LOCAL=
# Chat edits send file contents, so the 4k window a bare model ships with is far too small.
OMNISTACKAI_OLLAMA_CONTEXT_WINDOW_TOKENS=32768
OMNISTACKAI_OLLAMA_SAFE_INPUT_TOKENS=24576
OMNISTACKAI_OLLAMA_MAX_OUTPUT_TOKENS=4096
OMNISTACKAI_OLLAMA_REQUEST_TIMEOUT_SECONDS=300
OMNISTACKAI_OLLAMA_HEALTH_TIMEOUT_SECONDS=5
OMNISTACKAI_OLLAMA_MAX_CONCURRENCY=1
# Balanced routing sends sub-L3 work to local Ollama; a cloud provider is used only for L3/L4
# once one is registered by a later Tracker ID (R-008). Keep local-only until then.
OMNISTACKAI_MODEL_ROUTING_MODE=balanced
OMNISTACKAI_GATEWAY_PROMPT="Reply with exactly: gateway routed to local model"
# Cloud model provider (R-008/R-236, optional). Pick at most one as the L3/L4 cloud tier and set only
# that provider's key in the untracked .env. Empty here means local-only; no cloud call is made.
# Allowed: none | anthropic | openai | google | openrouter | groq | deepseek | xai | mistral |
#          together | fireworks | nvidia | <a custom provider id declared below>
OMNISTACKAI_CLOUD_PROVIDER=none
# Set only the key for the provider you selected above. Never commit real values.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
NVIDIA_API_KEY=
# Optional per-provider model overrides. Empty uses the adapter default shown in the comment.
OMNISTACKAI_ANTHROPIC_MODEL=
OMNISTACKAI_OPENAI_MODEL=
OMNISTACKAI_GOOGLE_MODEL=
OMNISTACKAI_OPENROUTER_MODEL=
OMNISTACKAI_GROQ_MODEL=
OMNISTACKAI_DEEPSEEK_MODEL=
OMNISTACKAI_XAI_MODEL=
OMNISTACKAI_MISTRAL_MODEL=
OMNISTACKAI_TOGETHER_MODEL=
OMNISTACKAI_FIREWORKS_MODEL=
# nvidia default: nvidia/nemotron-3-ultra-550b-a55b
OMNISTACKAI_NVIDIA_MODEL=
# Optional HTTPS override for NVIDIA's endpoint (default https://integrate.api.nvidia.com/v1).
NVIDIA_MODEL_BASE_URL=
# Custom (bring-your-own) OpenAI-compatible providers (R-236). Name them here (comma-separated ids),
# then for each id <X> set BASE_URL (HTTPS), MODEL, and API_KEY. They become first-class providers with
# no code change and can be selected as the cloud tier or a fallback by their id. Example:
#   OMNISTACKAI_CUSTOM_PROVIDERS=myco
#   OMNISTACKAI_CUSTOM_MYCO_BASE_URL=https://llm.myco.internal/v1
#   OMNISTACKAI_CUSTOM_MYCO_MODEL=myco-large
#   OMNISTACKAI_CUSTOM_MYCO_API_KEY=
OMNISTACKAI_CUSTOM_PROVIDERS=
# Conservative shared budgets for the selected cloud model (override per deployment).
OMNISTACKAI_CLOUD_CONTEXT_WINDOW_TOKENS=8192
OMNISTACKAI_CLOUD_SAFE_INPUT_TOKENS=6144
OMNISTACKAI_CLOUD_MAX_OUTPUT_TOKENS=1024
# Optional resilience: ordered fallback chain (comma-separated; "ollama" or a cloud provider name,
# each already key-present). Empty = single provider, no fallback. A circuit breaker is attached only
# when a chain is set.
OMNISTACKAI_FALLBACK_PROVIDERS=
OMNISTACKAI_CIRCUIT_FAILURE_THRESHOLD=3
OMNISTACKAI_CIRCUIT_COOLDOWN_SECONDS=30
# R-466: how a cloud provider's HTTP 429 is paced. The adapter waits the provider's Retry-After (plus 0.5s)
# and re-sends the same request up to RETRIES times, never waiting longer than MAX_RETRY_AFTER_SECONDS
# (a longer ask fails fast). Free tiers can ask for 1-3 minute waits: raise the cap for the hybrid CLI.
OMNISTACKAI_RATE_LIMIT_RETRIES=2
OMNISTACKAI_MAX_RETRY_AFTER_SECONDS=60
# Runtime (preview/sandbox) + deploy providers. Tier 0/1 = local (no keys).
# Tier 2/3 = set a provider key below and select it here.
# OMNISTACKAI_TIER is the single switch: 0/1 = local (no keys); 2 = use the cloud
# selections below (each needs its key). Change this one value to switch tiers.
OMNISTACKAI_TIER=0
OMNISTACKAI_RUNTIME_PROVIDER=local
OMNISTACKAI_DEPLOY_PROVIDER=none
# R-490: real SandboxLifecycleProvider selection (a separate concern from OMNISTACKAI_TIER's older
# plan-only runtime above) - none (default, sandboxing off), gvisor (free, self-hosted, needs
# runsc registered locally), e2b, vercel-sandbox, or daytona (each needs its key/config below).
OMNISTACKAI_SANDBOX_PROVIDER=none
# Sandbox providers (run generated apps off your machine):
E2B_API_KEY=
E2B_TEMPLATE_ID=
DAYTONA_API_KEY=
FLY_API_TOKEN=
# VERCEL_PROJECT_ID is required only for the vercel-sandbox runtime provider (POST /v2/sandboxes
# needs an existing Vercel project) - the vercel deploy provider below does not need it.
VERCEL_PROJECT_ID=
# Deploy/hosting providers:
VERCEL_TOKEN=
RENDER_API_KEY=
NETLIFY_AUTH_TOKEN=
OMNISTACKAI_CONTROL_PLANE_ADDRESS=127.0.0.1:8080
OMNISTACKAI_CONTROL_PLANE_PORT=8080
# R-470: the URL the Next.js console (apps/console-web) calls the control-plane on. Server-side
# only - kept distinct from OMNISTACKAI_CONTROL_PLANE_ADDRESS (what the control-plane binds to)
# since those could differ once either side is actually deployed.
OMNISTACKAI_CONTROL_PLANE_URL=http://127.0.0.1:8080
OMNISTACKAI_DATABASE_PING_TIMEOUT=2s
OMNISTACKAI_SHUTDOWN_TIMEOUT=10s
# R-469: how long an issued session bearer token stays valid, and how many credits a new
# account's free plan is granted on signup (local-model usage is always credit-exempt).
OMNISTACKAI_SESSION_TTL=720h
OMNISTACKAI_SIGNUP_CREDIT_GRANT=100
# R-472: where the control-plane's Job API (POST /jobs/build) reaches the agent-engine's Studio
# HTTP server (task agent-engine:studio:serve/:preview) - a configured URL, never Docker Compose,
# at this stage. CREDITS_PER_USD converts a build's real dollar cost (reported by the agent-engine
# as an integer cost_micros_usd) into a whole number of credits; 1000 means 1 credit = $0.001, a
# business/pricing knob you can retune without a code change.
# The control-plane reads this from inside a container, where 127.0.0.1 is the container itself.
OMNISTACKAI_AGENT_ENGINE_URL=http://host.docker.internal:4173
# How long a build or chat edit may take (project builds and the /jobs/build API). Raise it for a local model
# or multi-app builds: OMNISTACKAI_AGENT_CALL_TIMEOUT=30m
OMNISTACKAI_AGENT_CALL_TIMEOUT=5m
OMNISTACKAI_CREDITS_PER_USD=1000
OMNISTACKAI_POSTGRES_HOST=127.0.0.1
OMNISTACKAI_POSTGRES_DB=omnistackai
OMNISTACKAI_POSTGRES_USER=omnistackai
OMNISTACKAI_POSTGRES_PASSWORD=replace-with-a-local-only-password
OMNISTACKAI_POSTGRES_PORT=5432

# Console (R-496): public origin used for absolute metadata URLs (OpenGraph/Twitter images).
# Optional - leave unset in local dev; the console then falls back to http://127.0.0.1:<OMNISTACKAI_CONSOLE_PORT or 4321>.
OMNISTACKAI_CONSOLE_PUBLIC_URL=

# Git integration & GitHub App (R-501):
# Required for connecting GitHub accounts and creating/pushing repositories.
# When empty, instant .zip download remains 100% operational as the no-account path.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
# Secrets encryption (R-501, R-503 / F-05):
# OMNISTACKAI_SECRETS_KEY is a 32-byte key (64 hex characters, base64, or 32-char ASCII; e.g. `openssl rand -hex 32`) used to encrypt
# OAuth refresh tokens, per-project secrets, connector credentials and BYOK model keys at rest (AES-256-GCM).
# If unset, secrets endpoints return HTTP 503 instead of storing plaintext.
OMNISTACKAI_SECRETS_KEY=
# OMNISTACKAI_SECRETS_KEY_PREVIOUS is used during key rotation. When set, secrets decryptable
# by this key are re-encrypted with OMNISTACKAI_SECRETS_KEY on read.
OMNISTACKAI_SECRETS_KEY_PREVIOUS=


# ── Preview engine (PC-007) ─────────────────────────────────────────────────────────────────────
# auto (default): the local Node/pnpm/Python toolchain where installed, otherwise a container that
# needs only Docker. `container` forces the container engine; `local` forces the toolchain.
# OMNISTACKAI_PREVIEW_ENGINE=auto
# Container runtime override. Unset: gVisor (runsc) when Docker has it registered, else Docker's default.
# OMNISTACKAI_PREVIEW_RUNTIME=
# In-browser WebContainer engine (PC-096): StackBlitz commercial licence, supplied at go-live (PC-070).
# OMNISTACKAI_WEBCONTAINER_CLIENT_ID=

# ── Publish: the whole app at a live URL (PC-008) ──────────────────────────────────────────────
# Unset: this machine's Docker, each app on its own local port (the stand-in until go-live).
# A server: the same stack runs there over SSH (needs Docker on the server and your SSH key).
# OMNISTACKAI_PUBLISH_DOCKER_HOST=ssh://deploy@your-server
# A domain: each app at https://<app>.<domain>, certificates obtained automatically. Point a
# wildcard DNS record (*.apps.example.com) at the server first.
# OMNISTACKAI_PUBLISH_DOMAIN=apps.example.com
# Where the shared HTTPS proxy listens (defaults 0.0.0.0, 80, 443).
# OMNISTACKAI_PUBLISH_EDGE_BIND=0.0.0.0
# OMNISTACKAI_PUBLISH_EDGE_HTTP_PORT=80
# OMNISTACKAI_PUBLISH_EDGE_HTTPS_PORT=443

# ── Many users on one host (PC-009) ────────────────────────────────────────────────────────────
# multi: every preview runs in a container on a private network with no way out except the
# allowlist proxy, with its own preview database server and resource limits. Unset: one operator.
# OMNISTACKAI_TENANCY=multi
# The control plane's key to the Studio. scripts/omnistack.sh generates one; set your own when
# running the services elsewhere (both sides must have the same value).
# OMNISTACKAI_STUDIO_TOKEN=
# Fair shares per user and per host.
# OMNISTACKAI_MAX_PREVIEWS_PER_USER=2
# OMNISTACKAI_MAX_PREVIEWS=20
# OMNISTACKAI_BUILDS_PER_HOUR=30
# OMNISTACKAI_PREVIEW_IDLE_MINUTES=30
# Limits for one preview container.
# OMNISTACKAI_PREVIEW_MEMORY=2g
# OMNISTACKAI_PREVIEW_CPUS=2
# OMNISTACKAI_PREVIEW_PIDS=1024
# Extra hosts a preview may reach (package registries are always allowed). ".example.com" allows
# every subdomain.
# OMNISTACKAI_EGRESS_ALLOW=api.resend.com,api.stripe.com

# ── Credits and spending limits (PC-010) ───────────────────────────────────────────────────────
# Most one build or edit may spend (credits); never more than the user's balance.
# OMNISTACKAI_TASK_BUDGET_CREDITS=200
# Per-user caps: a runaway loop or a stolen session is stopped, with the time it resets.
# OMNISTACKAI_USER_HOURLY_CREDIT_CAP=300
# OMNISTACKAI_USER_DAILY_CREDIT_CAP=1500
# Whole-platform daily cap (0 = none) and the kill switch for all paid model work.
# OMNISTACKAI_PLATFORM_DAILY_CREDIT_CAP=0
# OMNISTACKAI_PAID_MODEL_WORK=paused
# Model prices in USD per million input/output tokens, over the built-in list. A model with no
# price costs users nothing. "provider:*" prices every model of a provider.
# OMNISTACKAI_MODEL_PRICES={"groq:openai/gpt-oss-120b":[0.15,0.75],"nvidia:*":[0,0]}

# ── Plans and platform billing (PC-011) ────────────────────────────────────────────────────────
# Plan limits and prices, over the beta defaults (D-1). A plan with a price goes on sale.
# OMNISTACKAI_PLANS={"pro":{"price_usd_monthly":29,"price_inr_monthly":2400,"stripe_price_id":"price_...","razorpay_plan_id":"plan_..."}}
# Credit packs (default: 5k/25k/100k credits at 1 credit = $0.001).
# OMNISTACKAI_CREDIT_PACKS=[{"id":"starter","name":"5,000 credits","credits":5000,"price_usd":5,"price_inr":420}]
# Where buyers return after a Stripe checkout (the console's public address).
# OMNISTACKAI_PUBLIC_URL=https://app.example.com
# Stripe (global): test keys sk_test_… until go-live. Webhook endpoint: <public url>/api/billing/webhooks/stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Razorpay (India): test keys rzp_test_… until go-live. Webhook endpoint: <public url>/api/billing/webhooks/razorpay
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ── Account basics (PC-012) ────────────────────────────────────────────────────────────────────
# Verification and password-reset emails go through Resend when both are set (keys at PC-070).
# Without them, OMNISTACKAI_DEV_MODE=1 writes each email (with its link) to the control-plane log;
# otherwise only the subject is logged and no email is sent. Links land on OMNISTACKAI_PUBLIC_URL.
# RESEND_API_KEY=
# EMAIL_FROM=OmniStackAI <no-reply@example.com>
# OMNISTACKAI_DEV_MODE=1
# The Terms/Privacy version new accounts accept (recorded per account; console and control plane).
# OMNISTACKAI_TERMS_VERSION=2026-09-27
# Building and publishing wait for a confirmed email; 0 switches that off (local development only).
# OMNISTACKAI_REQUIRE_EMAIL_VERIFICATION=1
# Days per-request model usage records are kept (the Privacy Policy says 400).
# OMNISTACKAI_MODEL_CALL_RETENTION_DAYS=400

# ── Model-designed pages (PC-098) ──────────────────────────────────────────────────────────────
# After every build the model designs each app's home page and main screens, while the template
# preview runs. Each page is type-checked and repaired, or keeps its built-in template. Billed and
# estimated like a build. "off" keeps template pages only.
# OMNISTACKAI_PAGE_DESIGN=on
# OMNISTACKAI_PAGE_DESIGN_MAX_PAGES=8
# Which model writes pages (default: the first configured of Google, Anthropic, OpenAI, DeepSeek,
# Mistral, Groq - Groq's free tier cannot take a page request). A project's own pinned model or
# key always wins.
# OMNISTACKAI_PAGE_PROVIDER=google
# OMNISTACKAI_PAGE_MODEL=gemini-3-flash-preview
# Answer budget for one page (a whole page plus the model's own reasoning).
# OMNISTACKAI_PAGE_MAX_OUTPUT_TOKENS=16384
# How long one page-design run may take (it waits out per-minute model limits), and the waits used.
# OMNISTACKAI_PAGE_DESIGN_TIMEOUT=60m
# OMNISTACKAI_PAGE_DESIGN_BUDGET_SECONDS=2400
# OMNISTACKAI_PAGE_RATE_LIMIT_WAITS=20,40,60

# File uploads in generated apps (PC-102): STORAGE_TARGET=dev uses R2 dev; prod uses R2 prod, else AWS S3; empty keys fall back to local disk. Guide: docs/runbooks/uploads-and-cloud-sources.md
OMNISTACKAI_STORAGE_TARGET=dev
OMNISTACKAI_R2_DEV_ACCOUNT_ID=
OMNISTACKAI_R2_DEV_ACCESS_KEY_ID=
OMNISTACKAI_R2_DEV_SECRET_ACCESS_KEY=
OMNISTACKAI_R2_DEV_BUCKET=
OMNISTACKAI_R2_DEV_PUBLIC_URL=
OMNISTACKAI_R2_PROD_ACCOUNT_ID=
OMNISTACKAI_R2_PROD_ACCESS_KEY_ID=
OMNISTACKAI_R2_PROD_SECRET_ACCESS_KEY=
OMNISTACKAI_R2_PROD_BUCKET=
OMNISTACKAI_R2_PROD_PUBLIC_URL=
OMNISTACKAI_S3_REGION=
OMNISTACKAI_S3_ACCESS_KEY_ID=
OMNISTACKAI_S3_SECRET_ACCESS_KEY=
OMNISTACKAI_S3_BUCKET=
OMNISTACKAI_S3_PUBLIC_URL=
OMNISTACKAI_LOCAL_STORAGE_DIR=

# Picking files from cloud drives (Uppy Companion, PC-102): each source appears only when its client ID and secret are set; COMPANION_SECRET is any long random string. Guide: docs/runbooks/uploads-and-cloud-sources.md
OMNISTACKAI_COMPANION_URL=http://localhost:3020
OMNISTACKAI_COMPANION_SECRET=
OMNISTACKAI_GOOGLE_DRIVE_CLIENT_ID=
OMNISTACKAI_GOOGLE_DRIVE_CLIENT_SECRET=
OMNISTACKAI_DROPBOX_APP_KEY=
OMNISTACKAI_DROPBOX_APP_SECRET=
OMNISTACKAI_ONEDRIVE_CLIENT_ID=
OMNISTACKAI_ONEDRIVE_CLIENT_SECRET=
OMNISTACKAI_BOX_CLIENT_ID=
OMNISTACKAI_BOX_CLIENT_SECRET=
