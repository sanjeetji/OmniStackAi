# CareClinic configuration. Copy to .env for local development outside the OmniStack preview
# (the preview sets PORT, DATABASE_URL, JWT_SECRET, BASE_PATH and the API URL itself).

# API (services/api)
DATABASE_URL=postgresql://localhost:5432/careclinic
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
PORT=4000
CORS_ORIGIN=*

# Providers: the template ships a mock video room, a mock payment gateway and mock SMS, none of
# which need credentials. To go live, implement the interface in services/api/src/services/
# (telehealth.ts, billing.ts) for your provider — for example Twilio Video or Daily for the call,
# Razorpay or Stripe for payments, MSG91 or Twilio for the token SMS — and add its keys here.

# Apps (apps/patient, apps/doctor, apps/admin)
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
