# RideNow configuration. Copy to .env for local development outside the OmniStack preview
# (the preview sets PORT, DATABASE_URL, JWT_SECRET, BASE_PATH and the API URLs itself).

# API (services/api)
DATABASE_URL=postgresql://localhost:5432/ridenow
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
PORT=4000
HOST=127.0.0.1
CORS_ORIGIN=*
# 1 = simulated drivers accept and drive automatically (demo). Use 0 in production.
DEMO_SIMULATION=0

# Providers: the template ships mock payments, maps and SMS that need no credentials. To go live,
# implement the interface in services/api/src/providers/ (payments.ts, maps.ts, sms.ts) for your
# provider (for example Stripe or Razorpay, Google Maps, Twilio or MSG91) and add its keys here.

# Apps (apps/rider, apps/driver, apps/admin)
API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
