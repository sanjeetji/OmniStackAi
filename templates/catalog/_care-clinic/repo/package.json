{
  "name": "care-clinic",
  "private": true,
  "description": "CareClinic: patient portal, doctor workstation, clinic ops console and API.",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev:api": "pnpm --filter @careclinic/api dev",
    "dev:patient": "pnpm --filter @careclinic/patient dev",
    "build:patient": "pnpm --filter @careclinic/patient build",
    "build": "pnpm -r --filter '!@careclinic/api' build",
    "test": "pnpm --filter @careclinic/api test",
    "typecheck": "pnpm -r typecheck"
  }
}
